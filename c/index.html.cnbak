<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0A1424">
<title>Cola Link ML — seu cupom</title>
<meta property="og:title" content="Cola Link ML — seu cupom tá pronto">
<meta property="og:description" content="Um toque copia o cupom e abre o produto no Mercado Livre.">
<meta property="og:image" content="https://www.monitorofertas.com.br/links/assets/og-image.jpg">
<link rel="icon" type="image/png" href="/colalink/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
  /* Identidade do Cola Link (as artes de bom dia, boa noite e novo cupom):
     fundo escuro com brilho amarelo, títulos grossos em caixa alta com
     pincelada amarela, o robô de boné, e o amarelo como a cor da ação. */
  :root {
    --yellow: #FFCC00;
    --yellow-2: #FFE15A;
    --navy: #0A1424;
    --navy-2: #111E33;
    --navy-3: #16253F;
    --white: #F4F7FB;
    --gray: #8A9BB0;
    --green: #25D366;
    --line: rgba(255, 255, 255, 0.09);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    min-height: 100vh; min-height: 100dvh;
    background: var(--navy);
    color: var(--white);
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.45;
  }
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      radial-gradient(ellipse 85% 42% at 50% 6%, rgba(255, 204, 0, 0.22) 0%, transparent 64%),
      radial-gradient(circle at 50% 108%, rgba(255, 204, 0, 0.10) 0%, transparent 46%);
    pointer-events: none;
  }
  .wrap {
    position: relative; z-index: 1;
    max-width: 440px; margin: 0 auto;
    padding: 14px 18px 34px;
    display: flex; flex-direction: column; align-items: center; text-align: center;
  }

  /* ── topo: o selo do Cola Link ───────────────────────────────────────── */
  .topo {
    display: flex; align-items: center; gap: 10px;
    align-self: flex-start;
  }
  .topo img { width: 42px; height: 42px; border-radius: 50%;
              filter: drop-shadow(0 4px 12px rgba(255, 204, 0, 0.35)); }
  .topo b {
    display: block; text-align: left;
    font: 800 15px/1 'Baloo 2', system-ui, sans-serif; letter-spacing: .5px;
  }
  .topo b span { color: var(--yellow); }
  .topo i { display: block; font-style: normal; font-size: 11px; color: var(--gray); margin-top: 3px; text-align: left; }

  /* ── o robô, com o balão ─────────────────────────────────────────────── */
  .heroi { position: relative; margin-top: 4px; }
  .robo {
    display: block; width: 168px; height: auto;
    animation: flutua 3.2s ease-in-out infinite;
  }
  @keyframes flutua { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  .balao {
    position: absolute; top: 18px; right: -58px;
    background: var(--yellow); color: var(--navy);
    font: 800 15px/1 'Baloo 2', system-ui, sans-serif;
    letter-spacing: .4px; text-transform: uppercase;
    padding: 8px 12px 6px; border-radius: 12px;
    transform: rotate(6deg);
    box-shadow: 0 6px 18px rgba(255, 204, 0, 0.35);
  }
  .balao::after {
    content: ''; position: absolute; left: 12px; bottom: -7px;
    border: 8px solid transparent; border-top-color: var(--yellow); border-bottom: 0;
    transform: skewX(-18deg);
  }

  /* ── título com a pincelada amarela das artes ────────────────────────── */
  h1 {
    margin-top: 6px;
    font: 800 30px/1.02 'Baloo 2', system-ui, sans-serif;
    letter-spacing: .3px; text-transform: uppercase;
  }
  h1 .amarelo { position: relative; display: inline-block; color: var(--yellow); }
  h1 .amarelo::after {
    content: ''; position: absolute; left: -2%; right: -3%; bottom: -5px; height: 5px;
    background: var(--yellow); opacity: .9; border-radius: 6px;
    transform: rotate(-1.5deg) skewX(-20deg);
  }
  .sub { margin-top: 10px; font-size: 14px; color: var(--gray); max-width: 330px; }
  .sub b { color: var(--white); font-weight: 700; }

  /* ── o tíquete do cupom: só pra VER (decisão do dono, 05/10) ────────────
     O código fica à mostra, mas não dá pra selecionar nem copiar dele: quem
     copia é o botão, que já abre o produto pelo nosso link. */
  .ticket {
    position: relative; width: 100%;
    margin-top: 18px; padding: 14px 20px 16px;
    background: linear-gradient(180deg, var(--navy-3), var(--navy-2));
    border: 2px solid var(--yellow); border-radius: 18px;
    box-shadow: 0 0 0 5px rgba(255, 204, 0, 0.07), 0 16px 36px rgba(0, 0, 0, 0.45),
                0 0 30px rgba(255, 204, 0, 0.16);
  }
  .ticket::before, .ticket::after {
    content: ''; position: absolute; top: 50%;
    width: 24px; height: 24px; margin-top: -12px; border-radius: 50%;
    background: var(--navy); border: 2px solid var(--yellow);
  }
  .ticket::before { left: -13px; clip-path: inset(0 0 0 50%); }
  .ticket::after  { right: -13px; clip-path: inset(0 50% 0 0); }
  .ticket__rot {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    font-size: 11px; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase;
    color: var(--yellow);
  }
  .ticket__rot svg { width: 15px; height: 15px; }
  .ticket__corte { margin: 10px 4px 8px; border-top: 2px dashed rgba(255, 204, 0, 0.35); }
  .codigo, .codigo2 {
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
    cursor: default;
  }
  .codigo {
    display: block;
    font: 800 clamp(26px, 8.6vw, 38px)/1.05 'Baloo 2', system-ui, sans-serif;
    letter-spacing: .07em; color: var(--yellow);
    text-shadow: 0 0 18px rgba(255, 204, 0, 0.30);
    word-break: break-all;
  }
  .ticket__pe { margin-top: 6px; font-size: 12px; color: var(--gray); }

  /* combo: o 2º cupom, que SOMA com o de cima — a área de transferência
     guarda um só, então este a pessoa digita (também está na mensagem) */
  .extra {
    display: none; width: 100%; margin-top: 10px; padding: 11px 14px;
    background: rgba(255, 204, 0, 0.07);
    border: 1px dashed rgba(255, 204, 0, 0.45); border-radius: 14px;
    font-size: 13px; color: #D8E2EE; text-align: center;
  }
  .extra b { color: var(--white); }
  .extra .mais { color: var(--yellow); font-weight: 800; font-size: 16px; margin-right: 2px; }
  .codigo2 {
    display: inline-block; margin-top: 6px; padding: 4px 12px 2px;
    border-radius: 10px; background: rgba(255, 204, 0, 0.12);
    font: 800 20px/1.1 'Baloo 2', system-ui, sans-serif; letter-spacing: .06em;
    color: var(--yellow);
  }

  /* ── o botão: o único jeito de copiar ────────────────────────────────── */
  .cta {
    width: 100%; margin-top: 16px;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    background: linear-gradient(180deg, var(--yellow-2) 0%, var(--yellow) 55%, #F2B800 100%);
    color: var(--navy);
    font: 800 17px/1.15 'Plus Jakarta Sans', system-ui, sans-serif;
    padding: 18px 18px; border: 0; border-radius: 16px;
    box-shadow: 0 12px 30px rgba(255, 204, 0, 0.34), inset 0 -3px 0 rgba(0, 0, 0, 0.12);
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: transform .08s ease, background .2s ease, box-shadow .2s ease;
  }
  .cta svg { width: 21px; height: 21px; flex-shrink: 0; }
  .cta:active { transform: scale(0.985); }
  .cta.ok {
    background: linear-gradient(180deg, #2BE875 0%, var(--green) 100%);
    color: #04280F; box-shadow: 0 12px 30px rgba(37, 211, 102, 0.38);
  }
  .aviso {
    display: none; width: 100%; margin-top: 12px; padding: 11px 13px;
    background: rgba(255, 120, 90, 0.08); border: 1px solid rgba(255, 140, 110, 0.4);
    border-radius: 12px; font-size: 13px; color: #FFD3C8; text-align: left;
  }
  .aviso b { color: var(--white); }

  /* ── como usar: o mesmo painel "COMO FUNCIONA?" das artes ────────────── */
  .como {
    position: relative; width: 100%; margin-top: 26px; padding: 22px 14px 14px;
    background: rgba(17, 30, 51, 0.85);
    border: 1.5px solid rgba(255, 204, 0, 0.55); border-radius: 16px;
  }
  .como__chip {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%) rotate(-2deg);
    background: var(--yellow); color: var(--navy);
    font: 800 13px/1 'Baloo 2', system-ui, sans-serif; letter-spacing: .6px;
    text-transform: uppercase; padding: 6px 14px 4px; border-radius: 6px; white-space: nowrap;
  }
  .passos { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: start; }
  .passo { display: flex; flex-direction: column; align-items: center; gap: 7px; }
  .passo .n {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--yellow); color: var(--navy);
    display: grid; place-items: center;
  }
  .passo .n svg { width: 18px; height: 18px; }
  .passo p { font-size: 12.5px; color: var(--gray); line-height: 1.35; }
  .passo p b { color: var(--white); }
  .passo p .y { color: var(--yellow); font-weight: 700; }
  .seta { color: var(--yellow); font-weight: 800; font-size: 18px; margin-top: 7px; }

  footer {
    margin-top: 22px; font-size: 12px; color: #64748B; line-height: 1.55; max-width: 330px;
  }
  footer b { color: #8A9BB0; }
  footer a { color: var(--yellow); text-decoration: none; font-weight: 700; }

  .erro { display: none; }
  .erro .cta { text-decoration: none; }

  @media (max-width: 360px) {
    h1 { font-size: 26px; }
    .robo { width: 144px; }
    .balao { right: -46px; font-size: 13px; }
  }
  /* economia de bateria no Android liga isto sozinho: tira só o MOVIMENTO */
  @media (prefers-reduced-motion: reduce) { .robo { animation: none; } }
</style>
</head>
<body>
<main class="wrap" id="ok">
  <div class="topo">
    <img src="/colalink/logo.png" alt="" width="42" height="42">
    <div><b>COLA <span>LINK</span></b><i>ML · melhor preço</i></div>
  </div>

  <div class="heroi">
    <img class="robo" src="/c/robo.webp" alt="" width="168" height="189">
    <div class="balao">Achei!</div>
  </div>

  <h1>Seu cupom<br><span class="amarelo">tá pronto!</span></h1>
  <p class="sub">Um toque <b>copia o cupom</b> e já <b>abre o produto</b> no Mercado Livre.</p>

  <div class="ticket" aria-label="Cupom">
    <div class="ticket__rot">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 10V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v4a2 2 0 1 1 0 4v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4a2 2 0 1 1 0-4Zm-6.3 6.7-1.4 1.4-6-6 1.4-1.4 6 6ZM9 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm6 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"/></svg>
      Seu cupom
    </div>
    <div class="ticket__corte"></div>
    <span class="codigo" id="codigo">…</span>
    <div class="ticket__pe">pra colar no pagamento</div>
  </div>

  <div class="extra" id="extra"><span class="mais">+</span> No pagamento, use <b>também</b> este — os dois somam.<br>
    Ele está na mensagem do grupo:<br><span class="codigo2" id="codigo2">…</span></div>

  <button class="cta" id="btn" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    <span id="btnTxt">Copiar cupom e ir pro produto</span>
  </button>
  <div class="aviso" id="aviso" role="status" aria-live="polite"></div>

  <section class="como">
    <span class="como__chip">Como usar?</span>
    <div class="passos">
      <div class="passo">
        <span class="n"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11m0-1.5a1.5 1.5 0 0 1 3 0V11m0-.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-4.6-2.2L4 15.5a1.6 1.6 0 0 1 2.4-2L9 15"/></svg></span>
        <p><b>Toque no botão</b><br>o cupom é <span class="y">copiado</span> e o produto abre</p>
      </div>
      <span class="seta" aria-hidden="true">›</span>
      <div class="passo">
        <span class="n"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2.5"/><path d="M2 10h20M6 15h4"/></svg></span>
        <p><b>No pagamento</b><br>toque em <span class="y">“Inserir código”</span> e cole</p>
      </div>
    </div>
  </section>

  <footer>
    Comprando pelo nosso link você <b>ajuda o Cola Link</b> a continuar 💛<br>
    <a href="https://www.monitorofertas.com.br/">monitorofertas.com.br</a>
  </footer>
</main>

<main class="wrap erro" id="erro">
  <div class="topo">
    <img src="/colalink/logo.png" alt="" width="42" height="42">
    <div><b>COLA <span>LINK</span></b><i>ML · melhor preço</i></div>
  </div>
  <div class="heroi"><img class="robo" src="/c/robo.webp" alt="" width="168" height="189"></div>
  <h1>Link <span class="amarelo">incompleto</span></h1>
  <p class="sub">Esse link de cupom não abriu. Volte ao grupo e toque no link do produto.</p>
  <a class="cta" href="https://www.monitorofertas.com.br/">Ir pro monitorofertas.com.br</a>
</main>

<script>
// Página "copiar cupom e ir pro produto" — Cola-Links V2 (05/10, pedido do dono).
// Formato B: /c/?<link curto do ML>-<CUPOM>, ex.: /c/?2EH37GA-BRINCADEIRAS.
// Combo (1 cupom da loja + 1 do ML, que SOMAM): /c/?<link>-<CUPOM>-<CUPOM2>. A
// área de transferência guarda um só: copia o 1º e mostra o 2º por escrito
// (decisão do dono, 05/10). O 2º também está na mensagem do grupo.
// Um toque copia o código E abre o produto pelo NOSSO link de afiliado
// (https://meli.la/<código>) — é por ele que a compra conta pra gente.
//
// ⚠️ O código fica À MOSTRA, mas não dá pra copiar da página (decisão do dono,
// 05/10): quem copia é o botão, que já leva pelo nosso link.
// ⚠️ Copiar exige o TOQUE da pessoa (medido 06/09 num Android: sem toque o
// navegador recusa, com toque copia). Por isso a cópia mora no clique do botão,
// nunca no carregamento. iPhone e o navegador interno do WhatsApp ainda não
// foram testados — o teste pelo ADM existe pra isso.

function lerLink(qs) {
  var s = String(qs || '').replace(/^[?#]/, '');
  var p = s.split('-');
  if (p.length < 2 || p.length > 3) return null;
  var meli = p[0];
  var cupom = p[1].toUpperCase();
  if (!/^[A-Za-z0-9]{4,12}$/.test(meli)) return null;
  if (!/^[A-Z0-9]{3,24}$/.test(cupom)) return null;
  var r = { meli: meli, cupom: cupom };
  if (p.length === 3) {
    var c2 = p[2].toUpperCase();
    if (!/^[A-Z0-9]{3,24}$/.test(c2) || c2 === cupom) return null;
    r.cupom2 = c2;
  }
  return r;
}

(function () {
  var dados = lerLink(location.search) || lerLink(location.hash);
  if (!dados) {
    document.getElementById('ok').style.display = 'none';
    document.getElementById('erro').style.display = 'flex';
    return;
  }
  var destino = 'https://meli.la/' + dados.meli;
  document.getElementById('codigo').textContent = dados.cupom;
  if (dados.cupom2) {
    document.getElementById('codigo2').textContent = dados.cupom2;
    document.getElementById('extra').style.display = 'block';
  }

  // O código não sai da página: sem seleção, sem menu de copiar, sem Ctrl+C.
  ['codigo', 'codigo2'].forEach(function (id) {
    var el = document.getElementById(id);
    ['selectstart', 'contextmenu', 'copy', 'dragstart'].forEach(function (ev) {
      el.addEventListener(ev, function (e) { e.preventDefault(); });
    });
  });
  document.addEventListener('copy', function (e) {
    var sel = window.getSelection && String(window.getSelection());
    if (sel && (sel.indexOf(dados.cupom) >= 0 || (dados.cupom2 && sel.indexOf(dados.cupom2) >= 0))) {
      e.preventDefault();
    }
  });

  // Medição (GA4, mesmo jeito do /r/: sendBeacon, nunca segura a navegação).
  var cid = '', sid = String(Math.floor(Date.now() / 1000));
  try {
    var m = /(?:^|;\s*)_ga=GA\d\.\d\.([\d.]+)/.exec(document.cookie || '');
    if (m) cid = m[1];
  } catch (e) { /* sem cookie → anônimo */ }
  if (!cid) cid = Math.floor(Math.random() * 1e10) + '.' + sid;
  function ga(evento) {
    try {
      var p = new URLSearchParams({
        v: '2', tid: 'G-6959NQX27C', cid: cid, en: evento, sid: sid,
        dl: location.href, dt: 'cupom',
        'ep.canal': 'c', 'ep.link': dados.meli, 'ep.cupom': dados.cupom,
        'ep.cupom2': dados.cupom2 || ''
      });
      navigator.sendBeacon('https://www.google-analytics.com/g/collect?' + p.toString());
    } catch (e) { /* contagem é best-effort */ }
  }
  ga('cupom_pagina_aberta');

  function copiarAntigo(txt) {
    try {
      var t = document.createElement('textarea');
      t.value = txt; t.setAttribute('readonly', '');
      t.style.position = 'fixed'; t.style.opacity = '0';
      document.body.appendChild(t); t.select();
      var ok = document.execCommand('copy');
      document.body.removeChild(t);
      return ok;
    } catch (e) { return false; }
  }

  function ir() { location.href = destino; }

  var btn = document.getElementById('btn');
  var btnTxt = document.getElementById('btnTxt');
  var aviso = document.getElementById('aviso');
  var falhou = false;
  btn.addEventListener('click', function () {
    if (falhou) { ga('cupom_foi_sem_copiar'); ir(); return; }
    function deuCerto() {
      ga('cupom_copiou_e_foi');
      btn.classList.add('ok');
      // Com 2 cupons: tempo pra ler o 2º antes de a página sumir.
      btnTxt.textContent = dados.cupom2
        ? 'Copiado! Lembre do 2º: ' + dados.cupom2
        : 'Cupom copiado! Abrindo o produto…';
      setTimeout(ir, dados.cupom2 ? 2500 : 700);
    }
    function naoDeu() {
      if (copiarAntigo(dados.cupom)) { deuCerto(); return; }
      falhou = true;
      ga('cupom_copia_falhou');
      aviso.innerHTML = '<b>Não deu pra copiar sozinho.</b> Anote o código do tíquete e toque de novo pra ir ao produto.';
      aviso.style.display = 'block';
      btnTxt.textContent = 'Ir pro produto ›';
    }
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(dados.cupom).then(deuCerto, naoDeu);
      } else {
        naoDeu();
      }
    } catch (e) { naoDeu(); }
  });
})();
</script>
</body>
</html>
